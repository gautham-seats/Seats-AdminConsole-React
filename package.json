{
  "name": "seats-admin-console",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build:check": "node -e \"process.env.ADMIN_ALLOW_WRITES=process.env.ADMIN_ALLOW_WRITES||'false';require('child_process').execSync('npx next build',{stdio:'inherit',env:process.env})\"",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run lint:types && npm run lint:deps && npm run lint:dead && npm test && npm run build:check",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "lint:dead": "knip",
    "lint:types": "type-coverage --strict --at-least 95",
    "lint:tokens": "node scripts/check-css-tokens.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-select": "2.3.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.4.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-fail-on-console": "3.3.4",
    "knip": "6.37.0",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "ts-jest": "29.4.12",
    "type-coverage": "2.30.1",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,mjs}": [
      "prettier --write"
    ]
  }
}
