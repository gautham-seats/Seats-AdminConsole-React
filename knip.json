{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{page,layout,error,global-error,not-found,loading}.tsx",
    "src/shared/*/index.ts",
    "src/shared/*/*/index.ts",
    ".github/scripts/*.mjs",
    "scripts/*.mjs"
  ],
  "project": ["src/**/*.{ts,tsx,css}", ".github/scripts/**/*.mjs", "scripts/**/*.mjs", "eslint-rules/*.mjs"],
  "ignoreDependencies": [],
  "rules": {
    "unlisted": "error",
    "unresolved": "error",
    "files": "error",
    "exports": "warn",
    "types": "warn",
    "dependencies": "error",
    "devDependencies": "error",
    "duplicates": "warn"
  }
}
